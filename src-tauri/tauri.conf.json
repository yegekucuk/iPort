{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iPort",
  "version": "0.1.0",
  "identifier": "com.yegekucuk.iport",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8888",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iPort",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "yegekucuk",
    "homepage": "https://github.com/yegekucuk/iPort",
    "copyright": "Copyright (c) 2026 yegekucuk",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform local port inspector and manager",
    "longDescription": "iPort is a lightweight, cross-platform desktop command center to inspect, classify, and manage every local listening port, dev server, Docker container, tunnel, and third-party application running on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "desktopTemplate": "linux/iport.desktop.hbs"
      },
      "rpm": {
        "release": "1",
        "desktopTemplate": "linux/iport.desktop.hbs"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
