{
  "name": "iport",
  "version": "0.1.0",
  "description": "Cross-platform desktop command center for inspecting and managing local listening ports",
  "license": "MIT",
  "author": "yegekucuk",
  "homepage": "https://github.com/yegekucuk/iPort#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yegekucuk/iPort.git"
  },
  "bugs": {
    "url": "https://github.com/yegekucuk/iPort/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package:deb": "tauri build --bundles deb",
    "package:rpm": "tauri build --bundles rpm",
    "package:appimage": "tauri build --bundles appimage",
    "release:check": "node scripts/check-release.mjs",
    "release:version": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.6",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
